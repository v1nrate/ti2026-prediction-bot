{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ti2026-prediction-bot",
  "main": "src/index-stratz.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BotState"
      ]
    }
  ]
}
